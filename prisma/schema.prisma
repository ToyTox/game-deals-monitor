generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model Game {
  id              Int      @id @default(autoincrement())
  title           String
  platform        String
  originalPrice   Float?
  currentPrice    Float?
  currency        String?
  discountPercent Float    @default(0)
  isFree          Boolean  @default(false)
  // game | demo | dlc | kit — выставляет BaseParser.saveGames по названию
  kind            String   @default("game")
  gameUrl         String
  imageUrl        String?
  description     String?

  saleEndDate     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  priceHistory    PriceHistory[]

  @@unique([title, platform])

  @@index([platform])
  @@index([discountPercent])
  @@index([isFree])
  @@index([kind])
  @@index([createdAt])
}

model PriceHistory {
  id              Int      @id @default(autoincrement())
  gameId          Int
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  oldPrice        Float?
  newPrice        Float?
  oldDiscount     Float    @default(0)
  newDiscount     Float    @default(0)

  createdAt       DateTime @default(now())

  @@index([gameId])
  @@index([createdAt])
}

model UpdateLog {
  id              Int      @id @default(autoincrement())
  platform        String
  gamesCount      Int
  newGames        Int
  updatedGames    Int
  freedGames      Int

  startTime       DateTime
  endTime         DateTime
  duration        Int
  status          String
  error           String?

  createdAt       DateTime @default(now())

  @@index([platform])
  @@index([createdAt])
}
