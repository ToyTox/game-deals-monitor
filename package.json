{
  "name": "game-deals-monitor",
  "version": "1.0.0",
  "description": "API для мониторинга скидок и бесплатных игр на Steam, Epic Games, GOG и других платформах",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/setup.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "games",
    "deals",
    "steam",
    "epic",
    "gog",
    "monitor",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18"
  }
}
