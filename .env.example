PORT=3000
NODE_ENV=development
DATABASE_URL="file:./prisma/dev.db"
CRON_SCHEDULE="0 6 * * *"
RUN_ON_STARTUP=true
LOG_LEVEL=info

# Регион Steam: cc влияет на валюту цен, l — на язык названий и описаний
STEAM_COUNTRY_CODE=ru
STEAM_LANGUAGE=russian
# Сколько страниц (по 100 игр) обойти в поиске по акциям; 0 — только витрина
STEAM_SEARCH_PAGES=3
# Пауза между пачками по 100 appid при чтении списка желаемого, мс
STEAM_WISHLIST_DELAY=300

# VK Play: у API магазина нет фильтров, каталог обходится постранично (75 игр на страницу — максимум API)
# 0 — обойти весь каталог (~137 страниц)
VKPLAY_MAX_PAGES=0
# true — сохранять только игры со скидкой; false — все продаваемые (~10000 записей)
VKPLAY_ONLY_DISCOUNTED=true
# Пауза между запросами одного воркера, мс
VKPLAY_REQUEST_DELAY=300
# Сколько страниц грузить одновременно; на 8 API начинает рвать соединения
VKPLAY_CONCURRENCY=3
# Базовая пауза перед повтором упавшей страницы, мс (растёт с номером попытки, всего 3 попытки)
VKPLAY_RETRY_DELAY=1000
