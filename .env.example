PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
CRON_SCHEDULE="0 6 * * *"
RUN_ON_STARTUP=true
LOG_LEVEL=info

# Регион Steam: cc влияет на валюту цен, l — на язык названий и описаний
STEAM_COUNTRY_CODE=ru
STEAM_LANGUAGE=russian
# Сколько страниц (по 100 игр) обойти в поиске по акциям; 0 — только витрина
STEAM_SEARCH_PAGES=3
