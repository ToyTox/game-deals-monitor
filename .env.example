PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
CRON_SCHEDULE="0 6 * * *"
RUN_ON_STARTUP=true
LOG_LEVEL=info

# Регион Steam: cc влияет на валюту цен, l — на язык названий и описаний
STEAM_COUNTRY_CODE=ru
STEAM_LANGUAGE=russian
# Сколько страниц (по 100 игр) обойти в поиске по акциям; 0 — только витрина
STEAM_SEARCH_PAGES=3

# VK Play: у API магазина нет фильтров, каталог обходится постранично (24 игры на страницу)
# 0 — обойти весь каталог (~424 страницы)
VKPLAY_MAX_PAGES=0
# true — сохранять только игры со скидкой; false — все продаваемые (~9000 записей)
VKPLAY_ONLY_DISCOUNTED=true
# Пауза между страницами, мс
VKPLAY_REQUEST_DELAY=300
